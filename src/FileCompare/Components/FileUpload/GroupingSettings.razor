@using FileCompare.Models

<div>
    <div class="grouping-row">
        <label>Number of groups:</label>
        <input type="number" min="1" max="10" value="@Config.Groups.Count" @onchange="OnGroupCountChanged" />
    </div>

    @for (var i = 0; i < Config.Groups.Count; i++)
    {
        var index = i;
        <div class="grouping-row">
            <label>Group @(index + 1) upper bound (absolute difference &le;):</label>
            <input type="number" step="0.01" min="0" value="@Config.Groups[index].UpperBound"
                   @onchange="e => OnBoundaryChanged(index, e)" />
        </div>
    }
    <div class="upload-hint">
        Rows with a difference greater than the last boundary fall into an overflow "greater than last boundary" group.
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DifferenceGroupingConfig Config { get; set; } = FileCompare.Models.DifferenceGroupingConfig.Default();

    [Parameter]
    public EventCallback<DifferenceGroupingConfig> ConfigChanged { get; set; }

    private async Task OnGroupCountChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var count) || count < 1)
        {
            return;
        }

        var groups = Config.Groups.ToList();
        if (count > groups.Count)
        {
            var lastBound = groups.Count > 0 ? groups[^1].UpperBound : 0m;
            for (var i = groups.Count; i < count; i++)
            {
                lastBound += 0.5m;
                groups.Add(new FileCompare.Models.GroupBoundary { UpperBound = lastBound });
            }
        }
        else if (count < groups.Count)
        {
            groups = groups.Take(count).ToList();
        }

        var updated = Config with { Groups = groups };
        await ConfigChanged.InvokeAsync(updated);
    }

    private async Task OnBoundaryChanged(int index, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var value) || value < 0)
        {
            return;
        }

        var groups = Config.Groups.ToList();
        groups[index] = new FileCompare.Models.GroupBoundary { UpperBound = value };
        var updated = Config with { Groups = groups };
        await ConfigChanged.InvokeAsync(updated);
    }
}
